# Скопируй в .env и заполни. Пустые поля = дефолт из config.js.

# ---- Обязательное для прода ----
# Токен бота от @BotFather. Без него сервер стартует в DEV-режиме
# (подпись Telegram НЕ проверяется) — только для локальной отладки!
BOT_TOKEN=

# Публичный HTTPS-адрес твоего Mini App (домен сервера).
# Если не задан — бот не запустится, только API. Telegram требует HTTPS.
WEBAPP_URL=

# Строгий CORS в проде: сюда — https://твой.домен. Пусто = запрет всех.
CORS_ORIGIN=

# ---- Оплата TON ----
# Адрес-получатель платежей. Пусто = TON-магазин отключён.
TON_RECEIVER=
# Ключ toncenter.com для повышенного rate-limit (опционально).
TONCENTER_API_KEY=

# ---- Хранилище ----
# 1 = SQLite (рекомендуется в проде), пусто/0 = JSON-файл
USE_SQLITE=
# Путь к JSON-хранилищу (если USE_SQLITE не включён)
DB_PATH=./data.json
# Путь к SQLite-файлу
SQLITE_PATH=./data.sqlite
# Путь к audit-логу
AUDIT_PATH=./audit.jsonl
# Каталог бэкапов (30 дней ротация)
BACKUP_DIR=./backups

# ---- Прочее ----
PORT=3000
# Секрет для HMAC-подписи gameId. Если пусто — генерится случайно
# при старте (перезапуск инвалидирует активные сессии).
GAME_SECRET=

# TG chat_id админа для алертов о фрауде. Смотри через @userinfobot.
ADMIN_CHAT_ID=

# ---- Прод-режим ----
# NODE_ENV=production включает safety-gate: сервер откажется стартовать,
# если BOT_TOKEN или CORS_ORIGIN пусты.
NODE_ENV=
